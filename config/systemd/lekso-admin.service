# Servicio de administración de LekSO: ejecuta como root lo que le pasa el permisor, y solo si el usuario ha dado
# permiso de administración a algún asistente en /etc/lekso/asistentes.json. Ver lekso_admin.py.
[Unit]
Description=Servicio de administración de LekSO (para los asistentes de IA)

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/lekso-ia/lekso_admin.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
