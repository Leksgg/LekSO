<?xml version="1.0"?>
<!-- LeksSO sobre labwc: ventanas con título y botones (minimizar, maximizar, cerrar), como en Windows. -->
<labwc_config>
  <theme>
    <name>LeksSO</name>
    <cornerRadius>0</cornerRadius>
    <font place="" name="DejaVu Sans" size="11" />
  </theme>

  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>

  <desktops number="1" />

  <windowSwitcher show="yes" preview="no" outlines="no" />

  <keyboard>
    <default />
    <!-- Mod = tecla Windows -->
    <keybind key="W-Return"><action name="Execute" command="leksso-term -T Terminal" /></keybind>
    <keybind key="W-d"><action name="Execute" command="fuzzel" /></keybind>
    <keybind key="W-e"><action name="Execute" command="pcmanfm-qt" /></keybind>
    <keybind key="W-a"><action name="Execute" command="leksso-term -T 'Panel de la IA' -e python3 /usr/local/lib/leksso-ia/panel.py" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
  </keyboard>
</labwc_config>
