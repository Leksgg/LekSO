#!/usr/bin/env python3
"""Energía de LekSO: bloquear, suspender, hibernar, cerrar sesión, reiniciar y apagar.

Solo muestra activas las opciones que el equipo admite (por ejemplo, hibernar necesita
espacio de intercambio). Las que cierran lo que estás haciendo piden confirmación.
Se cierra con la X, con Esc o al elegir una opción.
"""
import subprocess
import sys

from PySide6 import QtCore, QtWidgets

sys.path.insert(0, "/usr/local/lib/lekso-ui")
from lekso_ui import ESTILO, alternar  # noqa: E402


def admite(metodo):
    """Pregunta a logind si el equipo puede hacerlo (yes / challenge = sí)."""
    r = subprocess.run(
        ["busctl", "call", "org.freedesktop.login1", "/org/freedesktop/login1",
         "org.freedesktop.login1.Manager", metodo],
        capture_output=True, text=True)
    return r.returncode == 0 and ('"yes"' in r.stdout or '"challenge"' in r.stdout)


# (texto, descripción, orden, método de logind o None, pide confirmación, peligro)
ACCIONES = [
    ("Bloquear", "Pide la contraseña para volver", ["swaylock", "-f", "-c", "10151b"], None, False, False),
    ("Suspender", "Pausa el equipo y gasta muy poco", ["systemctl", "suspend"], "CanSuspend", False, False),
    ("Hibernar", "Guarda todo en el disco y apaga", ["systemctl", "hibernate"], "CanHibernate", True, False),
    ("Cerrar sesión", "Cierra tus programas y vuelve al inicio", ["swaymsg", "exit"], None, True, False),
    ("Reiniciar", "Apaga y vuelve a encender", ["systemctl", "reboot"], "CanReboot", True, True),
    ("Apagar", "Apaga el equipo", ["systemctl", "poweroff"], "CanPowerOff", True, True),
]


class Energia(QtWidgets.QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Energía")
        self.setStyleSheet(ESTILO)
        raiz = QtWidgets.QVBoxLayout(self)
        raiz.setContentsMargins(14, 10, 14, 14)
        cab = QtWidgets.QHBoxLayout()
        t = QtWidgets.QLabel("Energía")
        t.setObjectName("titulo")
        cab.addWidget(t)
        cab.addStretch()
        x = QtWidgets.QPushButton("✕")
        x.setObjectName("cerrar")
        x.setToolTip("Cerrar (Esc)")
        x.clicked.connect(self.close)
        cab.addWidget(x)
        raiz.addLayout(cab)
        for nombre, desc, orden, metodo, confirma, peligro in ACCIONES:
            ok = metodo is None or admite(metodo)
            b = QtWidgets.QPushButton(f"{nombre}\n{desc}" if ok else f"{nombre}\nNo disponible en este equipo")
            b.setObjectName("peligro" if peligro else "accion")
            b.setEnabled(ok)
            b.clicked.connect(lambda _=False, n=nombre, o=orden, c=confirma: self.hacer(n, o, c))
            raiz.addWidget(b)
        raiz.addStretch()

    def hacer(self, nombre, orden, confirma):
        if confirma:
            r = QtWidgets.QMessageBox.question(
                self, nombre, f"¿{nombre}?\nSe cerrará lo que tengas abierto sin guardar.",
                QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No, QtWidgets.QMessageBox.No)
            if r != QtWidgets.QMessageBox.Yes:
                return
        self.hide()
        subprocess.Popen(orden, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        QtCore.QTimer.singleShot(300, self.close)

    def keyPressEvent(self, ev):
        if ev.key() == QtCore.Qt.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(ev)


def main():
    if alternar("lekso-energia"):
        return 0
    app = QtWidgets.QApplication(sys.argv)
    app.setDesktopFileName("lekso-energia")
    w = Energia()
    w.resize(360, 460)
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
