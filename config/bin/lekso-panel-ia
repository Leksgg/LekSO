#!/bin/sh
# Lleva al panel de la IA (donde se aprueban las peticiones). Si no está abierto, lo abre.
# Lo usan el atajo Mod+A y el aviso «La IA pide permiso».
if [ -z "${SWAYSOCK:-}" ]; then
  SWAYSOCK="$(ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/sway-ipc.*.sock 2>/dev/null | tail -1)"; export SWAYSOCK
fi
if swaymsg -t get_tree 2>/dev/null | grep -q '"app_id": "lekso-ia"'; then
  swaymsg '[app_id="lekso-ia"] focus' >/dev/null
else
  exec lekso-term -T "Panel de la IA" --app-id lekso-ia -e python3 /usr/local/lib/lekso-ia/panel.py
fi
