#!/usr/bin/env python3
"""Actualizaciones de LekSO: qué versión tienes, si hay una nueva y qué cambia.

Instalar pide tu contraseña en una terminal, para que veas lo que pasa. Nada se instala solo.
Se cierra con la X o con Esc.
"""
import json
import os
import subprocess
import sys

from PySide6 import QtCore, QtWidgets

sys.path.insert(0, "/usr/local/lib/lekso-ui")
from lekso_ui import ESTILO, alternar  # noqa: E402


def sal(*cmd, tiempo=40):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=tiempo)
        return r.stdout.strip() or r.stderr.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def cache():
    try:
        return json.load(open(os.path.expanduser("~/.cache/lekso/actualizacion.json"), encoding="utf-8"))
    except (OSError, ValueError):
        return {}


class Trabajo(QtCore.QThread):
    listo = QtCore.Signal(str, str)

    def __init__(self, orden, etiqueta):
        super().__init__()
        self.orden, self.etiqueta = orden, etiqueta

    def run(self):
        self.listo.emit(self.etiqueta, sal(*self.orden))


class Ventana(QtWidgets.QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Actualizaciones")
        self.setStyleSheet(ESTILO)
        raiz = QtWidgets.QVBoxLayout(self)
        raiz.setContentsMargins(14, 10, 14, 14)
        cab = QtWidgets.QHBoxLayout()
        t = QtWidgets.QLabel("Actualizaciones")
        t.setObjectName("titulo")
        cab.addWidget(t)
        cab.addStretch()
        x = QtWidgets.QPushButton("✕")
        x.setObjectName("cerrar")
        x.setToolTip("Cerrar (Esc)")
        x.clicked.connect(self.close)
        cab.addWidget(x)
        raiz.addLayout(cab)
        self.actual = QtWidgets.QLabel()
        self.actual.setStyleSheet("font-size: 18px; font-weight: bold;")
        raiz.addWidget(self.actual)
        self.estado = QtWidgets.QLabel()
        self.estado.setWordWrap(True)
        raiz.addWidget(self.estado)
        self.cambios = QtWidgets.QPlainTextEdit()
        self.cambios.setReadOnly(True)
        self.cambios.setPlaceholderText("Aquí aparece lo que trae la versión nueva.")
        raiz.addWidget(self.cambios, 1)
        fila = QtWidgets.QHBoxLayout()
        self.b_comprobar = QtWidgets.QPushButton("Buscar versión nueva")
        self.b_comprobar.setObjectName("accion")
        self.b_comprobar.clicked.connect(self.comprobar)
        self.b_instalar = QtWidgets.QPushButton("Actualizar ahora")
        self.b_instalar.setObjectName("accion")
        self.b_instalar.clicked.connect(self.instalar)
        self.b_volver = QtWidgets.QPushButton("Volver a la anterior")
        self.b_volver.setObjectName("accion")
        self.b_volver.clicked.connect(self.volver)
        for b in (self.b_comprobar, self.b_instalar, self.b_volver):
            fila.addWidget(b)
        raiz.addLayout(fila)
        nota = QtWidgets.QLabel("Solo se instalan versiones firmadas por LekSO. Se te pide la contraseña en una terminal.")
        nota.setObjectName("nota")
        nota.setWordWrap(True)
        raiz.addWidget(nota)
        self.refrescar()
        if cache().get("disponible"):
            self.ver_cambios()

    def refrescar(self):
        self.actual.setText(sal("lekso-actualizar", "version"))
        c = cache()
        disp = c.get("disponible")
        self.b_instalar.setEnabled(bool(disp))
        self.b_volver.setEnabled(os.path.exists("/var/lib/lekso/version-anterior"))
        if disp:
            self.estado.setText(f"Hay una versión nueva: {sal('lekso-actualizar', 'version', disp) or disp}. Léela abajo y actualiza cuando quieras.")
        elif c.get("comprobado"):
            self.estado.setText("Estás al día.")
        else:
            self.estado.setText("Todavía no se ha comprobado. Pulsa «Buscar versión nueva».")

    def comprobar(self):
        self.b_comprobar.setEnabled(False)
        self.estado.setText("Buscando…")
        self.t = Trabajo(["lekso-actualizar", "comprobar"], "comprobar")
        self.t.listo.connect(self.fin)
        self.t.start()

    def ver_cambios(self):
        self.t2 = Trabajo(["lekso-actualizar", "cambios"], "cambios")
        self.t2.listo.connect(self.fin)
        self.t2.start()

    def fin(self, etiqueta, texto):
        if etiqueta == "comprobar":
            self.b_comprobar.setEnabled(True)
            self.refrescar()
            self.estado.setText(texto or self.estado.text())
            if cache().get("disponible"):
                self.ver_cambios()
        else:
            self.cambios.setPlainText(texto)

    def terminal(self, titulo, orden):
        subprocess.Popen(["lekso-term", "-T", titulo, "-e", "sh", "-c",
                          orden + '; printf "\\n\\nPulsa Intro para cerrar."; read -r _'],
                         start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.close()

    def instalar(self):
        self.terminal("Actualizar LekSO", "sudo lekso-actualizar aplicar")

    def volver(self):
        r = QtWidgets.QMessageBox.question(self, "Volver", "¿Volver a la versión anterior de LekSO?",
                                           QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No, QtWidgets.QMessageBox.No)
        if r == QtWidgets.QMessageBox.Yes:
            self.terminal("Volver a la versión anterior", "sudo lekso-actualizar volver")

    def keyPressEvent(self, ev):
        if ev.key() == QtCore.Qt.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(ev)


def main():
    if alternar("lekso-actualizaciones"):
        return 0
    app = QtWidgets.QApplication(sys.argv)
    app.setDesktopFileName("lekso-actualizaciones")
    w = Ventana()
    w.resize(620, 520)
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
