#!/usr/bin/env bash
# Teclas de volumen, micrófono, brillo y multimedia, con aviso en pantalla.
# Uso: lekso-medios volumen-subir|volumen-bajar|volumen-silencio|micro-silencio|brillo-subir|brillo-bajar|play|siguiente|anterior
aviso() { # texto, porcentaje (opcional)
  if [ -n "$2" ]; then
    notify-send -t 1500 -u low -h string:x-canonical-private-synchronous:lekso-osd -h "int:value:$2" "$1"
  else
    notify-send -t 1500 -u low -h string:x-canonical-private-synchronous:lekso-osd "$1"
  fi
}
vol() { wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d", $2*100}'; }
case "${1:-}" in
  volumen-subir)    wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; aviso "Volumen $(vol)%" "$(vol)" ;;
  volumen-bajar)    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; aviso "Volumen $(vol)%" "$(vol)" ;;
  volumen-silencio) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
                    if wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED; then aviso "Sonido silenciado"; else aviso "Volumen $(vol)%" "$(vol)"; fi ;;
  micro-silencio)   wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
                    if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then aviso "Micrófono silenciado"; else aviso "Micrófono activo"; fi ;;
  brillo-subir)     brightnessctl -q set 5%+ 2>/dev/null && aviso "Brillo $(brightnessctl -m | cut -d, -f4)" "$(brightnessctl -m | cut -d, -f4 | tr -d %)" ;;
  brillo-bajar)     brightnessctl -q set 5%- 2>/dev/null && aviso "Brillo $(brightnessctl -m | cut -d, -f4)" "$(brightnessctl -m | cut -d, -f4 | tr -d %)" ;;
  play)             playerctl play-pause ;;
  siguiente)        playerctl next ;;
  anterior)         playerctl previous ;;
  *) echo "Uso: lekso-medios volumen-subir|volumen-bajar|volumen-silencio|micro-silencio|brillo-subir|brillo-bajar|play|siguiente|anterior" >&2; exit 2 ;;
esac
