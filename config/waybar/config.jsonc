[
  {
    "name": "raiz",
    "layer": "top",
    "position": "left",
    "width": 56,
    "spacing": 6,
    "modules-left": [
      "custom/apps",
      "custom/archivos",
      "custom/portapapeles",
      "custom/modelos",
      "custom/asistente",
      "custom/streamdeck",
      "custom/config"
    ],
    "custom/archivos": {
      "format": "",
      "tooltip-format": "Archivos",
      "on-click": "pcmanfm-qt"
    },
    "custom/modelos": {
      "format": "",
      "tooltip-format": "Modelos de IA",
      "on-click": "lekso-term -T \"Modelos de IA\" -e python3 /usr/local/lib/lekso-ia/modelo.py lista"
    },
    "custom/config": {
      "format": "",
      "tooltip-format": "Ajustes",
      "on-click": "lekso-ajustes"
    },
    "modules-right": [
      "custom/flotantes",
      "custom/vista",
      "custom/energia"
    ],
    "custom/vista": {
      "format": "",
      "tooltip-format": "Restaurar la vista por defecto",
      "on-click": "sh -c 'lekso-zonas --restaurar >/tmp/lekso-zonas.log 2>&1'"
    },
    "custom/streamdeck": {
      "format": "",
      "tooltip-format": "Stream Deck",
      "on-click": "streamdeck"
    },
    "custom/apps": {
      "format": "",
      "tooltip-format": "Aplicaciones",
      "on-click": "lekso-menu"
    },
    "custom/energia": {
      "format": "",
      "tooltip-format": "Apagar, suspender, hibernar…",
      "on-click": "lekso-energia"
    },
    "custom/asistente": {
      "format": "",
      "tooltip-format": "Asistente de IA",
      "on-click": "lekso-term -T \"Asistente de IA\" --app-id lekso-asistente -e sh -c 'lekso-asistente; printf \"\n\nSesion terminada. Pulsa Intro para cerrar esta ventana (se vuelve a abrir desde el boton del asistente).\n\"; read -r _'"
    },
    "custom/flotantes": {
      "format": "",
      "tooltip-format": "Ocultar o mostrar las ventanas flotantes",
      "on-click": "lekso-flotantes"
    },
    "custom/portapapeles": {
      "format": "",
      "tooltip-format": "Historial del portapapeles (Mod+V)",
      "on-click": "lekso-portapapeles"
    }
  },
  {
    "name": "tareas",
    "layer": "top",
    "position": "bottom",
    "height": 34,
    "spacing": 0,
    "modules-left": [
      "wlr/taskbar"
    ],
    "modules-center": [],
    "modules-right": [
      "custom/version",
      "custom/actualizacion",
      "custom/ia",
      "cpu",
      "memory",
      "pulseaudio",
      "battery",
      "network",
      "clock"
    ],
    "wlr/taskbar": {
      "format": "{icon} {title:.26}",
      "ignore-list": ["Operativa usuario", "Panel de la IA"],
      "icon-size": 18,
      "all-outputs": true,
      "on-click": "activate",
      "on-click-middle": "close",
      "tooltip-format": "{title} (clic central: cerrar)",
      "max-length": 22
    },
    "custom/ia": {
      "exec": "python3 /usr/local/lib/lekso-ia/modelo.py estado",
      "on-click": "lekso-panel-ia",
      "return-type": "json",
      "interval": 30
    },
    "cpu": {
      "format": "CPU {usage}%",
      "interval": 3,
      "states": {
        "warning": 80,
        "critical": 95
      }
    },
    "memory": {
      "format": "RAM {used:0.1f} GB",
      "tooltip-format": "{used:0.1f} de {total:0.1f} GB en uso",
      "interval": 3,
      "states": {
        "warning": 80,
        "critical": 92
      }
    },
    "pulseaudio": {
      "format": "  {volume}%",
      "format-muted": "  sin sonido",
      "tooltip-format": "{desc}\nVolumen {volume}%",
      "scroll-step": 5,
      "on-click": "pavucontrol-qt",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
      "format-ethernet": "  Cable",
      "format-wifi": "  {signalStrength}%",
      "format-disconnected": "  Sin red",
      "tooltip-format-ethernet": "Cable · {ifname}\nIP {ipaddr}\nPuerta de enlace {gwaddr}",
      "tooltip-format-wifi": "Wi-Fi: {essid}\nSeñal {signalStrength}%\nIP {ipaddr}",
      "tooltip-format-disconnected": "Sin conexión",
      "on-click": "lekso-term -T \"Redes\" -e lekso-redes"
    },
    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "{:%A %d de %B de %Y}"
    },
    "battery": {
      "format": "{icon}  {capacity}%",
      "format-icons": ["", "", "", "", ""],
      "format-charging": " {icon}  {capacity}%",
      "format-plugged": " {icon}  {capacity}%",
      "states": {
        "warning": 25,
        "critical": 10
      },
      "tooltip-format": "Batería {capacity}%\n{timeTo}",
      "tooltip-format-charging": "Cargando · {capacity}%\n{timeTo}",
      "tooltip-format-plugged": "Enchufado · {capacity}% (no carga: batería llena o protegida)",
      "interval": 30
    },
    "custom/version": {
      "exec": "lekso-actualizar version",
      "interval": 600,
      "tooltip-format": "Versión instalada de LekSO (clic: actualizaciones)",
      "on-click": "lekso-actualizaciones"
    },
    "custom/actualizacion": {
      "exec": "lekso-actualizar barra",
      "return-type": "json",
      "interval": 900,
      "hide-empty-text": true,
      "on-click": "lekso-actualizaciones"
    }
  }
]
