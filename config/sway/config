# LekSO sobre sway: escritorio por zonas.
# Raíl de iconos a la izquierda | explorador | centro (la app activa, a pantalla completa de su zona,
# con terminal debajo) | panel de la IA a la derecha. Barra de tareas abajo.
# Las zonas las monta lekso-zonas al iniciar.

set $mod Mod4
set $term foot
set $menu lekso-menu

default_border pixel 1
titlebar_border_thickness 0
titlebar_padding 8 4
font pango:DejaVu Sans 11
workspace_layout default

# Colores (misma paleta que la barra): una sola pestaña activa en cian, el resto apagado.
#                         borde    fondo    texto    indicador  borde hijo
client.focused            #4cc3e0  #16384a  #dfe6ee  #4cc3e0    #4cc3e0
client.focused_inactive   #2a3644  #1c2530  #8a98a8  #2a3644    #2a3644
client.unfocused          #2a3644  #171e27  #8a98a8  #2a3644    #2a3644
client.urgent             #f0b24a  #3a2d12  #f0b24a  #f0b24a    #f0b24a

output * bg #10151b solid_color
gaps inner 0

exec waybar
exec python3 /usr/local/lib/lekso-ia/permisor.py
exec lekso-zonas
exec udiskie --no-tray --no-notify --automount

# El menú de aplicaciones flota en el centro de la pantalla
for_window [app_id="lekso-menu"] floating enable, resize set 480 620, move position center

# Atajos básicos (Mod = tecla Windows)
bindsym $mod+Return exec foot -T Terminal
bindsym $mod+d exec $menu
bindsym $mod+e exec pcmanfm-qt
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaymsg exit
bindsym $mod+a exec foot -T "Panel de la IA" -e python3 /usr/local/lib/lekso-ia/panel.py

# Cambiar de app en el centro
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev
bindsym Mod1+Tab focus next
bindsym $mod+f fullscreen toggle

# Mover el foco entre zonas con las flechas
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# Ajustes locales de este equipo (por ejemplo, la resolución en una máquina virtual).
include ~/.config/sway/local.conf
